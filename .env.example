# Auth Configuration
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=your-secret-here

# Get these from Google Cloud Console OAuth credentials
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# For Vercel deployment (optional, but recommended)
# Set to your production URL, e.g., https://your-app.vercel.app
# NEXTAUTH_URL=https://your-app.vercel.app

# Allowed emails (comma-separated) - only these emails can access the app
ALLOWED_EMAILS=your-email@gmail.com,another-email@gmail.com

# Vercel KV (Redis) - Required for production
# This is automatically set by Vercel when you create a KV store
# No need to set it locally - it'll be auto-injected in development
# REDIS_URL=
# REDIS_TOKEN= (if required)
